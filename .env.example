NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/adverse
JWT_SECRET=replace-with-a-long-random-secret-before-production
# AI intent and research providers; server-side only. Keep all credentials in Render environment settings.
GROQ_API_KEY=
GROQ_INTENT_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
OPENCORPORATES_API_TOKEN=
# Optional Brevo transactional email alerts; keep the API key server-side.
BREVO_API_KEY=
# Required for password-reset emails; must be a verified Brevo sender.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=ADVERSE
# Required for monitoring-alert emails.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Required for scheduled archive monitoring; set the same random secret on API and Render cron service.
MONITORING_CRON_SECRET=

# Private admin access. Set the real password only in the hosting provider's environment; never commit it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
